# PulseWatch Environment Variables

# App Environment: development | production | testing
ENVIRONMENT=development
APP_NAME=PulseWatch
LOG_LEVEL=INFO

# Security / JWT
# IMPORTANT: Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Database
# Default uses SQLite for easy local dev/eval, or PostgreSQL connection string
DATABASE_URL=sqlite:///./pulsewatch.db
# PostgreSQL example: postgresql+psycopg2://pulsewatch:pulsewatch_pass@localhost:5432/pulsewatch_db

# Cache / Redis
# If Redis is not available, app gracefully falls back to thread-safe in-memory cache
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Market Data Provider: demo | yahoo
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=

# Freshness Thresholds (seconds)
FRESHNESS_FRESH_SECONDS=60
FRESHNESS_AGING_SECONDS=300

# Server Port
PORT=8000
